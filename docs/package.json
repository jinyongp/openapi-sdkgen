{
  "name": "openapi-sdkgen-docs",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "playground:build": "node ./scripts/build-playground.mjs",
    "docs:validate": "node ./scripts/build-compatibility-results.mjs && node ./scripts/validate-feature-manifest.mjs && node ./scripts/validate-locales.mjs",
    "docs:validate:test": "node ./scripts/validate-locales-test.mjs && node --test ./scripts/compatibility-results.test.mjs ./scripts/ci-measurements.test.mjs ./scripts/playground-download.test.mjs",
    "docs:dev": "node ./scripts/build-compatibility-results.mjs && node ./scripts/validate-locales.mjs && node ./scripts/build-playground.mjs && vitepress dev .",
    "docs:build": "node ./scripts/build-compatibility-results.mjs && node ./scripts/validate-feature-manifest.mjs && node ./scripts/validate-locales.mjs && node ./scripts/build-playground.mjs && vitepress build .",
    "docs:preview": "vitepress preview .",
    "playground:test": "node ./scripts/build-playground.mjs && node --test ./scripts/playground-wasm.test.mjs"
  },
  "devDependencies": {
    "@lucide/vue": "1.59.0",
    "@sectile/chart": "0.15.7",
    "@shikijs/langs": "^4.5.0",
    "@shikijs/themes": "^4.5.0",
    "fflate": "0.8.3",
    "shiki": "^4.5.0",
    "vitepress": "^1.6.4"
  }
}
