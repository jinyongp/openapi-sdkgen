{
  "openapi": "3.2.0",
  "info": { "title": "xml-and-stream", "version": "1" },
  "paths": {
    "/probe": {
      "post": {
        "operationId": "probe",
        "requestBody": {
          "required": true,
          "content": {
            "application/xml": {
              "schema": {
                "type": "object",
                "required": ["id"],
                "properties": { "id": { "type": "string" } },
                "additionalProperties": false,
                "xml": { "name": "item" }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/x-ndjson": {
                "itemSchema": {
                  "type": "object",
                  "required": ["id"],
                  "properties": { "id": { "type": "string" } },
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    }
  }
}
