                "schema": {
                  "type": "object",
                  "required": ["id"],
                  "properties": { "id": { "type": "string" } },
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": { "auth": { "type": "apiKey", "in": "cookie", "name": "X-API-Key" } }
  },
  "security": [{ "auth": [] }]
