{
  "name": "openapi-sdkgen-typescript-conformance",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint .",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "conformance": "corepack pnpm run typecheck && corepack pnpm run test"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "@vitest/coverage-v8": "5.0.0",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": "24.x",
    "pnpm": "12.x"
  },
  "packageManager": "pnpm@12.4.1"
}
