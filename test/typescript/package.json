{
  "name": "openapi-sdkgen-typescript-conformance",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint .",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "conformance": "corepack pnpm run typecheck && corepack pnpm run test"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.11",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.24.0"
  },
  "packageManager": "pnpm@11.24.0"
}
