const todoJSON = `{"id":"one","title":"Measured todo"}`

type memoryTransport struct {
	body         string
	status       int
	media        string
	checkAuth    bool
	open, closed atomic.Int64
}

func (t *memoryTransport) Capabilities() types.TransportCapabilities {
	return types.TransportCapabilities{ResponseBody: types.Encoded}
}
func (t *memoryTransport) Do(r *http.Request, _ types.TransportOptions) (*http.Response, error) {
	if t.checkAuth && r.Header.Get("Authorization") != "Bearer measured-token" {
		return nil, fmt.Errorf("missing provider credential")
	}
	if r.Body != nil {
		if _, err := io.Copy(io.Discard, r.Body); err != nil {
			return nil, err
		}
		r.Body.Close()
	}
	t.open.Add(1)
	return &http.Response{StatusCode: t.status, Header: http.Header{"Content-Type": {t.media}}, Body: &countedBody{Reader: strings.NewReader(t.body), onClose: func() { t.closed.Add(1) }}}, nil
}

type countedBody struct {
	io.Reader
	onClose func()
	once    sync.Once
	reads   int
}

func (b *countedBody) Read(p []byte) (int, error) { b.reads++; return b.Reader.Read(p) }
func (b *countedBody) Close() error               { b.once.Do(b.onClose); return nil }
func client(b testing.TB, t *memoryTransport) *api.Client {
	b.Helper()
	c, err := api.NewClient(api.ClientOptions{BaseURL: "https://example.test", Transport: t, Codecs: measuredCodecs(t.checkAuth), SecurityProvider: func(context.Context, types.SecurityCredentialContext) (types.SecurityCredentials, error) {
		return types.SecurityCredentials{"bearer": {Kind: "http-bearer", Token: "measured-token"}}, nil
	}})
	if err != nil {
		b.Fatal(err)
	}
	return c
}
func measuredCodecs(enabled bool) map[string]types.MediaCodec {
	if !enabled {
		return nil
	}
	return map[string]types.MediaCodec{"application/json": {Decode: func(_ context.Context, response *http.Response, _ types.MediaContext) (types.Value, error) {
		body, err := io.ReadAll(response.Body)
		if err != nil {
			return types.Value{}, err
		}
		return types.ParseValue(body)
	}}}
}
func assertClosed(b testing.TB, t *memoryTransport) {
	b.Helper()
	if t.open.Load() != t.closed.Load() {
		b.Fatalf("response leak %d/%d", t.open.Load(), t.closed.Load())
	}
}

func BenchmarkSmallJSON(b *testing.B) {
	for _, mode := range []string{"http-json", "do", "raw", "error"} {
		b.Run(mode, func(b *testing.B) {
			t := &memoryTransport{body: todoJSON, status: 200, media: "application/json"}
			if mode == "error" {
				t.status = 500
			}
			c := client(b, t)
			ctx := context.Background()
			b.ReportAllocs()
			b.ResetTimer()
			for b.Loop() {
				switch mode {
				case "http-json":
					req, err := http.NewRequestWithContext(ctx, "GET", "https://example.test/todo", nil)
					if err != nil {
						b.Fatal(err)
					}
					r, err := t.Do(req, types.TransportOptions{})
					if err != nil {
						b.Fatal(err)
					}
					var value struct{ ID, Title string }
					decoder := json.NewDecoder(r.Body)
					decoder.DisallowUnknownFields()
					err = decoder.Decode(&value)
					r.Body.Close()
					if err != nil || value.ID != "one" || value.Title != "Measured todo" {
						b.Fatal(value, err)
					}
				case "do":
					v, err := c.Operations.Todo().Do(ctx)
					if err != nil {
						b.Fatal(err)
					}
					_ = v
				case "raw":
					v, err := c.Operations.Todo().Raw(ctx)
					if err != nil {
						b.Fatal(err)
					}
					_ = v
				case "error":
					_, err := c.Operations.Todo().Do(ctx)
					if err == nil {
						b.Fatal("error response accepted")
					}
				}
			}
			b.StopTimer()
			assertClosed(b, t)
		})
	}
}

func BenchmarkLargeJSON(b *testing.B) {
	for _, size := range []int{1024, 1 << 20, 16 << 20} {
		b.Run(fmt.Sprint(size), func(b *testing.B) {
			prefix := `{"text":"`
			suffix := `","choice":1,"next":{"text":"nested","choice":"branch"},"extra":"value"}`
			data := []byte(prefix + strings.Repeat("x", size-len(prefix)-len(suffix)) + suffix)
			ctx := context.Background()
			b.SetBytes(int64(len(data)))
			b.ReportAllocs()
			var before, after runtime.MemStats
			runtime.ReadMemStats(&before)
			b.ResetTimer()
			for b.Loop() {
				v, err := types.ParseValue(data)
				if err != nil {
					b.Fatal(err)
				}
				dto, err := models.DecodeNodeInput(ctx, v)
				if err != nil {
					b.Fatal(err)
				}
				encoded, err := models.EncodeNodeInput(ctx, dto)
				if err != nil || !encoded.Equal(v) {
					b.Fatal(err)
				}
			}
			b.StopTimer()
			runtime.ReadMemStats(&after)
			b.ReportMetric(float64(after.NumGC-before.NumGC)/float64(b.N), "GC/op")
		})
	}
}
