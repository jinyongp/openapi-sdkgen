#!/usr/bin/env bash
set -euo pipefail
source "$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)/scripts/agent/lib.sh"
cd "$ROOT"
if [[ $# -ne 2 ]]; then
  echo "usage: just agent inspect-benchmark CORPUS_DIRECTORY REPORT_JSON" >&2
  exit 2
fi
"$ROOT/scripts/agent/build"
if command -v fnm >/dev/null 2>&1; then
  agent_run "inspect corpus benchmark" fnm exec --using "$NODE_VERSION" node scripts/inspect-benchmark.mjs "$@"
else
  require_system_node
  agent_run "inspect corpus benchmark" node scripts/inspect-benchmark.mjs "$@"
fi
