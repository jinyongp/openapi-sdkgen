#!/usr/bin/env bash
set -euo pipefail
source "$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)/scripts/agent/lib.sh"
cd "$ROOT"
mkdir -p "$ROOT/.tmp/bin"
generator="$ROOT/.tmp/bin/named-clients-generator"
benchmark="$ROOT/.tmp/bin/named-clients-benchmark"
agent_run "build named clients generator" go build -o "$generator" ./cmd/openapi-sdkgen
agent_run "build named clients phase measurement driver" go build -o "$benchmark" ./scripts/clients-benchmark
agent_run "named clients delivery verification" ts_node node "$TYPESCRIPT_ROOT/verification/named-clients.mjs" --generator "$generator" --benchmark "$benchmark" "$@"
