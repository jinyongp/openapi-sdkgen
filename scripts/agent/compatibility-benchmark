#!/usr/bin/env bash
set -euo pipefail
source "$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)/scripts/agent/lib.sh"

if [[ $# -lt 3 || $# -gt 7 ]]; then
  echo "usage: $0 <manifest.json> <corpus-directory> <report.json> [typecheck-timeout] [document-id] [selection.toml] [metadata]" >&2
  exit 2
fi

manifest="$1"
corpus="$2"
output="$3"
timeout="${4:-3m}"
document="${5:-}"
selection="${6:-}"
addon="${7:-}"
binary="$ROOT/.tmp/bin/openapi-sdkgen-compat-benchmark"
arguments=(
  --mode run
  --manifest "$manifest"
  --corpus-root "$corpus"
  --output "$output"
  --typescript-root "$TYPESCRIPT_ROOT"
  --typecheck-timeout "$timeout"
)
if [[ -n "$document" ]]; then
  arguments+=(--document "$document")
fi
if [[ -n "$selection" ]]; then
  arguments+=(--selection "$selection")
fi
if [[ -n "$addon" ]]; then
  arguments+=(--with "$addon")
fi

agent_run "build compatibility benchmark" go build -o "$binary" ./scripts/compat-benchmark
if command -v fnm >/dev/null 2>&1; then
  agent_run "compatibility benchmark" fnm exec --using "$NODE_VERSION" "$binary" "${arguments[@]}"
else
  require_system_node
  agent_run "compatibility benchmark" "$binary" "${arguments[@]}"
fi
