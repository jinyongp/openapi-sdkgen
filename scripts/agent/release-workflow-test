#!/usr/bin/env bash
set -euo pipefail
source "$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)/scripts/agent/lib.sh"

workflow="$ROOT/.github/workflows/release.yml"
ci_workflow="$ROOT/.github/workflows/ci.yml"
npm_manifest="$ROOT/npm/package.json"
homebrew_check="$ROOT/.github/workflows/homebrew.yml"
dependabot="$ROOT/.github/dependabot.yml"
goreleaser="$ROOT/.goreleaser.yaml"
release_check="$ROOT/scripts/release/check.sh"
npm_package="$ROOT/scripts/npm/package.sh"
npm_check="$ROOT/scripts/npm/check.sh"
homebrew_formula="$ROOT/.github/homebrew/formula.yml"
release_asset_prep="$ROOT/scripts/release/prepare-assets.py"
releaseway_actions_sha="49c543357d96884d0e5a683c45d45ebd50a8b612"
homebrew_actions_sha="c035d14050bca1e2028a6368823797d36c9cdbc5"

require_file_text() {
  local file="$1" text="$2" label="$3"
  if ! grep -Fq -- "$text" "$file"; then
    echo "$label is missing required contract: $text" >&2
    exit 1
  fi
}

reject_file_text() {
  local file="$1" text="$2" label="$3"
  if grep -Fq -- "$text" "$file"; then
    echo "$label contains forbidden contract: $text" >&2
    exit 1
  fi
}

require_file_pattern() {
  local file="$1" pattern="$2" label="$3"
  if ! grep -Eq "$pattern" "$file"; then
    echo "$label is missing required contract: $pattern" >&2
    exit 1
  fi
}

reject_file_pattern() {
  local file="$1" pattern="$2" label="$3"
  if grep -Eq "$pattern" "$file"; then
    echo "$label contains forbidden contract: $pattern" >&2
    exit 1
  fi
}

require_text() { require_file_text "$workflow" "$1" "release workflow"; }
reject_text() { reject_file_text "$workflow" "$1" "release workflow"; }

require_text "workflow_dispatch:"
require_text "run-name: Release"
require_text "group: openapi-sdkgen-release"
require_text "Validate release tag"
require_text "Verify immutable tag target"
require_text "Build npm package"
require_text "scripts/npm/package.sh"
require_text "scripts/npm/publish.sh"
require_text '$GITHUB_WORKSPACE/.tmp/npm-package'
require_text "needs: [validate-release, publish-github-release]"

require_text "uses: releaseway/actions@${releaseway_actions_sha} # v0.1.4"
require_text "args: release --clean --skip=publish --config"
require_text "Prepare releaseway assets"
require_text "prepare-release-assets.py"
require_text 'prerelease: ${{ contains(needs.validate-release.outputs.tag, '\''-'\'') && '\''true'\'' || '\''false'\'' }}'
require_text 'generate-notes: "true"'
require_text "dist/checksums.txt"
require_text 'dist/openapi-sdkgen_${{ needs.validate-release.outputs.version }}_darwin_amd64.tar.gz'
require_text 'dist/openapi-sdkgen_${{ needs.validate-release.outputs.version }}_darwin_arm64.tar.gz'
require_text 'dist/openapi-sdkgen_${{ needs.validate-release.outputs.version }}_linux_amd64.tar.gz'
require_text 'dist/openapi-sdkgen_${{ needs.validate-release.outputs.version }}_linux_arm64.tar.gz'
require_text 'dist/openapi-sdkgen_${{ needs.validate-release.outputs.version }}_windows_amd64.zip'
require_text 'dist/openapi-sdkgen_${{ needs.validate-release.outputs.version }}_windows_arm64.zip'
require_text 'dist/openapi-sdkgen_${{ needs.validate-release.outputs.version }}_darwin_amd64'
require_text 'dist/openapi-sdkgen_${{ needs.validate-release.outputs.version }}_darwin_arm64'
require_text 'dist/openapi-sdkgen_${{ needs.validate-release.outputs.version }}_linux_amd64'
require_text 'dist/openapi-sdkgen_${{ needs.validate-release.outputs.version }}_linux_arm64'
require_text 'dist/openapi-sdkgen_${{ needs.validate-release.outputs.version }}_windows_amd64.exe'
require_text 'dist/openapi-sdkgen_${{ needs.validate-release.outputs.version }}_windows_arm64.exe'
reject_text 'https://api.github.com/repos/$GITHUB_REPOSITORY/releases/tags/$TAG'
reject_file_text "$goreleaser" "replace_existing_artifacts:" "GoReleaser config"
require_file_text "$goreleaser" "main.version={{ .Version }}" "GoReleaser config"
require_file_text "$goreleaser" "id: npm-binary" "GoReleaser config"
require_file_text "$goreleaser" "formats: [binary]" "GoReleaser config"
require_file_text "$goreleaser" "ArtifactExt" "GoReleaser config"
reject_file_text "$goreleaser" "target_commitish:" "GoReleaser config"

require_text "uses: releaseway/homebrew-actions/.github/workflows/publish.yml@${homebrew_actions_sha} # v0.1.0"
require_text "tap-repository: jinyongp/homebrew-tap"
require_text 'commit: ${{ needs.validate-release.outputs.commit }}'
require_text 'version: ${{ needs.validate-release.outputs.version }}'
require_text 'tap_deploy_key: ${{ secrets.HOMEBREW_TAP_DEPLOY_KEY }}'
reject_text "jinyongp/homebrew-tap/.github/workflows/publish-formula.yml"
reject_file_pattern "$workflow" '^[[:space:]]+deploy_key:' "release workflow"

require_file_text "$homebrew_check" "pull_request:" "Homebrew check workflow"
require_file_text "$homebrew_check" "uses: releaseway/homebrew-actions/.github/workflows/check.yml@${homebrew_actions_sha} # v0.1.0" "Homebrew check workflow"
require_file_text "$homebrew_check" "tap-repository: jinyongp/homebrew-tap" "Homebrew check workflow"
reject_file_text "$homebrew_check" "secrets:" "Homebrew check workflow"
if [[ -e "$ROOT/.github/workflows/auto-merge-homebrew-tap.yml" ]]; then
  echo "obsolete Homebrew auto-merge workflow must be removed" >&2
  exit 1
fi

require_file_text "$dependabot" "package-ecosystem: github-actions" "Dependabot config"
require_file_text "$dependabot" "releaseway:" "Dependabot config"
require_file_text "$dependabot" "releaseway/actions" "Dependabot config"
require_file_text "$dependabot" "releaseway/homebrew-actions/.github/workflows/check.yml" "Dependabot config"
require_file_text "$dependabot" "releaseway/homebrew-actions/.github/workflows/publish.yml" "Dependabot config"
reject_file_text "$dependabot" "jinyongp/homebrew-tap/.github/workflows/" "Dependabot config"

direct_release_jobs="$(grep -Ec '^[[:space:]]+needs: validate-release$' "$workflow")"
if [[ "$direct_release_jobs" != "1" ]]; then
  echo "only the GitHub Release job may start directly after tag validation, found $direct_release_jobs" >&2
  exit 1
fi

require_file_text "$npm_manifest" '"node": ">=22"' "npm package manifest"
require_file_text "$ci_workflow" "npm-launcher-node22:" "CI workflow"
require_file_text "$ci_workflow" 'node-version: "22.23.2"' "CI workflow"
require_file_text "$ci_workflow" 'node-version: "24.21.0"' "CI workflow"
require_file_text "$ci_workflow" "just agent npm-package 0.0.0-node22.0" "CI workflow"
require_file_text "$ci_workflow" "just agent npm-package-check .tmp/npm-package" "CI workflow"
require_file_text "$release_check" "run typecheck" "release check"
require_file_text "$release_check" 'run_step "TypeScript test coverage"' "release check"
require_file_text "$release_check" "go env GOCACHE" "release check"
require_file_text "$release_check" "go env GOMODCACHE" "release check"
require_file_text "$release_check" "SECONDS" "release check"
reject_file_text "$release_check" "run test" "release check"
reject_file_text "$release_check" "run conformance" "release check"
reject_text "Verify npm package"
reject_text "scripts/npm/check.sh"
reject_text "Verify release inputs"
reject_text "Run release checks"
reject_text "scripts/release/check.sh"
reject_text "just agent"

reject_file_text "$npm_package" "go build" "npm package script"
reject_file_text "$npm_package" "NPM_PACKAGE_BUILD_JOBS" "npm package script"
require_file_text "$npm_package" 'cp -R "$ROOT/npm/."' "npm package script"
require_file_text "$npm_check" "launcher-test.mjs" "npm package check"
require_file_text "$npm_check" "contains bundled native platform binaries" "npm package check"
require_file_pattern "$homebrew_formula" '^name: openapi-sdkgen$' "Homebrew Formula spec"
if ! grep -Fq -- '-X main.version=#{version}' "$homebrew_formula"; then
  echo "Homebrew builds must inject the formula version" >&2
  exit 1
fi

asset_test_root="$(mktemp -d "${TMPDIR:-/tmp}/openapi-sdkgen-release-assets.XXXXXX")"
trap 'rm -rf "$asset_test_root"' EXIT
asset_test_dist="$asset_test_root/dist"
mkdir -p "$asset_test_dist"
version="9.8.7"

cat >"$asset_test_dist/artifacts.json" <<EOF
[
  {"type":"Binary","goos":"darwin","goarch":"amd64","path":"$asset_test_dist/darwin-amd64/openapi-sdkgen","extra":{"ID":"openapi-sdkgen"}},
  {"type":"Binary","goos":"darwin","goarch":"arm64","path":"$asset_test_dist/darwin-arm64/openapi-sdkgen","extra":{"ID":"openapi-sdkgen"}},
  {"type":"Binary","goos":"linux","goarch":"amd64","path":"$asset_test_dist/linux-amd64/openapi-sdkgen","extra":{"ID":"openapi-sdkgen"}},
  {"type":"Binary","goos":"linux","goarch":"arm64","path":"$asset_test_dist/linux-arm64/openapi-sdkgen","extra":{"ID":"openapi-sdkgen"}},
  {"type":"Binary","goos":"windows","goarch":"amd64","path":"$asset_test_dist/windows-amd64/openapi-sdkgen.exe","extra":{"ID":"openapi-sdkgen"}},
  {"type":"Binary","goos":"windows","goarch":"arm64","path":"$asset_test_dist/windows-arm64/openapi-sdkgen.exe","extra":{"ID":"openapi-sdkgen"}}
]
EOF

for platform in darwin-amd64 darwin-arm64 linux-amd64 linux-arm64 windows-amd64 windows-arm64; do
  mkdir -p "$asset_test_dist/$platform"
  case "$platform" in
    windows-*) binary="openapi-sdkgen.exe" ;;
    *) binary="openapi-sdkgen" ;;
  esac
  printf '%s\n' "$platform" >"$asset_test_dist/$platform/$binary"
done

for goos in darwin linux; do
  for goarch in amd64 arm64; do
    printf '%s\n' "$goos/$goarch archive" >"$asset_test_dist/openapi-sdkgen_${version}_${goos}_${goarch}.tar.gz"
  done
done
for goarch in amd64 arm64; do
  printf '%s\n' "windows/$goarch archive" >"$asset_test_dist/openapi-sdkgen_${version}_windows_${goarch}.zip"
done

python3 "$release_asset_prep" --dist "$asset_test_dist" --version "$version"

python3 - "$asset_test_dist" "$version" <<'PY'
import hashlib
import sys
from pathlib import Path

dist = Path(sys.argv[1])
version = sys.argv[2]
expected = {
    f"openapi-sdkgen_{version}_{goos}_{goarch}{suffix}"
    for goos, suffix in (("darwin", ""), ("linux", ""), ("windows", ".exe"))
    for goarch in ("amd64", "arm64")
}
expected.update(
    {
        f"openapi-sdkgen_{version}_{goos}_{goarch}{suffix}"
        for goos, suffix in (("darwin", ".tar.gz"), ("linux", ".tar.gz"), ("windows", ".zip"))
        for goarch in ("amd64", "arm64")
    }
)
lines = (dist / "checksums.txt").read_text().splitlines()
if len(lines) != len(expected):
    raise SystemExit(f"unexpected checksum line count: {len(lines)}")
seen = set()
for line in lines:
    digest, name = line.split("  ", 1)
    path = dist / name
    if name not in expected or not path.is_file():
        raise SystemExit(f"unexpected release checksum entry: {name}")
    actual = hashlib.sha256(path.read_bytes()).hexdigest()
    if digest != actual:
        raise SystemExit(f"checksum mismatch for {name}")
    seen.add(name)
if seen != expected:
    raise SystemExit(f"missing release assets: {sorted(expected - seen)}")
PY

npm_pack_count="$(grep -Ec '^[[:space:]]*npm pack ' "$npm_check")"
if [[ "$npm_pack_count" != "1" ]]; then
  echo "npm package check must create exactly one tarball, found $npm_pack_count npm pack commands" >&2
  exit 1
fi

agent_note "ok release workflow contract"
