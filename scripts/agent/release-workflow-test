#!/usr/bin/env bash
set -euo pipefail
source "$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)/scripts/agent/lib.sh"

workflow="$ROOT/.github/workflows/release.yml"
homebrew_check="$ROOT/.github/workflows/homebrew.yml"
homebrew_auto_merge="$ROOT/.github/workflows/auto-merge-homebrew-tap.yml"
dependabot="$ROOT/.github/dependabot.yml"
goreleaser="$ROOT/.goreleaser.yaml"
release_check="$ROOT/scripts/release/check.sh"
npm_package="$ROOT/scripts/npm/package.sh"
npm_check="$ROOT/scripts/npm/check.sh"
homebrew_formula="$ROOT/.github/homebrew/formula.yml"
homebrew_tap_sha="5d4694353a9ed933fe0be9055ca64b7eef53e4f0"
homebrew_tap_release='automation-v1\.5\.0'

require_file_pattern() {
  local file="$1"
  local pattern="$2"
  local label="$3"
  if ! grep -Eq "$pattern" "$file"; then
    echo "$label is missing required contract: $pattern" >&2
    exit 1
  fi
}

reject_file_pattern() {
  local file="$1"
  local pattern="$2"
  local label="$3"
  if grep -Eq "$pattern" "$file"; then
    echo "$label contains forbidden contract: $pattern" >&2
    exit 1
  fi
}

require_pattern() {
  require_file_pattern "$workflow" "$1" "release workflow"
}

reject_pattern() {
  reject_file_pattern "$workflow" "$1" "release workflow"
}

reject_release_check_pattern() {
  local pattern="$1"
  if grep -Eq "$pattern" "$release_check"; then
    echo "release check contains forbidden contract: $pattern" >&2
    exit 1
  fi
}

require_goreleaser_pattern() {
  local pattern="$1"
  if ! grep -Eq "$pattern" "$goreleaser"; then
    echo "GoReleaser config is missing required release contract: $pattern" >&2
    exit 1
  fi
}

require_release_check_pattern() {
  local pattern="$1"
  if ! grep -Eq "$pattern" "$release_check"; then
    echo "release check is missing required contract: $pattern" >&2
    exit 1
  fi
}

require_pattern 'workflow_dispatch:'
require_pattern 'run-name: Release'
require_pattern 'group: openapi-sdkgen-release'
require_pattern 'Validate release tag'
require_pattern 'Verify immutable tag target'
require_pattern 'Build npm package'
require_pattern 'scripts/npm/package\.sh'
require_pattern 'scripts/npm/publish\.sh'
require_pattern '\$GITHUB_WORKSPACE/\.tmp/npm-package'
require_pattern "uses: jinyongp/homebrew-tap/\\.github/workflows/publish-formula\\.yml@${homebrew_tap_sha} # ${homebrew_tap_release}"
require_pattern 'formula: openapi-sdkgen'
require_pattern 'repository: \$\{\{ github\.repository \}\}'
require_pattern 'ref: \$\{\{ needs\.validate-release\.outputs\.commit \}\}'
require_pattern 'version: \$\{\{ needs\.validate-release\.outputs\.tag \}\}'
require_pattern 'deploy_key: \$\{\{ secrets\.HOMEBREW_TAP_DEPLOY_KEY \}\}'
require_pattern 'Publish GitHub Release'
require_pattern 'release-tools/\.goreleaser\.yaml'
require_goreleaser_pattern 'replace_existing_artifacts: true'
require_goreleaser_pattern 'main\.version=\{\{ \.Version \}\}'
require_goreleaser_pattern 'id: npm-binary'
require_goreleaser_pattern 'formats: \[binary\]'
require_goreleaser_pattern 'ArtifactExt'
require_pattern 'needs: \[validate-release, publish-github-release\]'
require_pattern 'openapi-sdkgen_\$\{version\}_darwin_amd64'
require_pattern 'openapi-sdkgen_\$\{version\}_darwin_arm64'
require_pattern 'openapi-sdkgen_\$\{version\}_linux_amd64'
require_pattern 'openapi-sdkgen_\$\{version\}_linux_arm64'
require_pattern 'openapi-sdkgen_\$\{version\}_windows_amd64\.exe'
require_pattern 'openapi-sdkgen_\$\{version\}_windows_arm64\.exe'
if grep -Eq 'target_commitish:' "$goreleaser"; then
  echo "GoReleaser must not override the target of an existing release tag" >&2
  exit 1
fi
require_pattern 'contents: write'
reject_pattern 'just agent'
require_release_check_pattern 'run typecheck'
require_release_check_pattern 'run_step "TypeScript test coverage"'
require_release_check_pattern 'go env GOCACHE'
require_release_check_pattern 'go env GOMODCACHE'
require_release_check_pattern 'SECONDS'
reject_release_check_pattern 'run test'
reject_release_check_pattern 'run conformance'
reject_pattern 'Verify npm package'
reject_pattern 'scripts/npm/check\.sh'
reject_pattern 'Verify release inputs'
reject_pattern 'Run release checks'
reject_pattern 'scripts/release/check\.sh'
reject_pattern 'uses: \./tap/actions/publish/formula'
reject_pattern 'scripts/commit-formula\.sh'
reject_pattern 'scripts/push-formula\.sh'
reject_pattern 'scripts/resolve-source-inputs\.sh'
reject_pattern 'brew tap '

require_file_pattern "$homebrew_check" 'pull_request:' 'Homebrew check workflow'
require_file_pattern "$homebrew_check" "uses: jinyongp/homebrew-tap/\\.github/workflows/publish-formula\\.yml@${homebrew_tap_sha} # ${homebrew_tap_release}" 'Homebrew check workflow'
require_file_pattern "$homebrew_check" 'formula: openapi-sdkgen' 'Homebrew check workflow'
require_file_pattern "$homebrew_check" 'dry-run: true' 'Homebrew check workflow'
require_file_pattern "$homebrew_check" 'validation-mode: spec' 'Homebrew check workflow'
reject_file_pattern "$homebrew_check" '^[[:space:]]*secrets:' 'Homebrew check workflow'

require_file_pattern "$homebrew_auto_merge" 'pull_request_target:' 'Homebrew auto-merge workflow'
require_file_pattern "$homebrew_auto_merge" 'contents: write' 'Homebrew auto-merge workflow'
require_file_pattern "$homebrew_auto_merge" 'pull-requests: write' 'Homebrew auto-merge workflow'
require_file_pattern "$homebrew_auto_merge" 'statuses: write' 'Homebrew auto-merge workflow'
require_file_pattern "$homebrew_auto_merge" "uses: jinyongp/homebrew-tap/\\.github/workflows/auto-merge-homebrew-tap\\.yml@${homebrew_tap_sha} # ${homebrew_tap_release}" 'Homebrew auto-merge workflow'
reject_file_pattern "$homebrew_auto_merge" 'actions/checkout' 'Homebrew auto-merge workflow'
reject_file_pattern "$homebrew_auto_merge" '^[[:space:]]*steps:' 'Homebrew auto-merge workflow'
reject_file_pattern "$homebrew_auto_merge" '^[[:space:]]*run:' 'Homebrew auto-merge workflow'

require_file_pattern "$dependabot" 'package-ecosystem: github-actions' 'Dependabot config'
require_file_pattern "$dependabot" 'homebrew-tap:' 'Dependabot config'
require_file_pattern "$dependabot" 'jinyongp/homebrew-tap/\.github/workflows/publish-formula\.yml' 'Dependabot config'
require_file_pattern "$dependabot" 'jinyongp/homebrew-tap/\.github/workflows/auto-merge-homebrew-tap\.yml' 'Dependabot config'
require_file_pattern "$dependabot" 'exclude-patterns:' 'Dependabot config'

parallel_publish_jobs="$(grep -Ec '^[[:space:]]+needs: validate-release$' "$workflow")"
if [[ "$parallel_publish_jobs" != "2" ]]; then
  echo "GitHub Release and Homebrew jobs must start directly after tag validation, found $parallel_publish_jobs" >&2
  exit 1
fi

if ! grep -Eq 'NPM_PACKAGE_BUILD_JOBS' "$npm_package" || ! grep -Eq 'go build .*&$' "$npm_package" || ! grep -Eq 'wait "\$\{build_pids\[\$index\]\}"' "$npm_package"; then
  echo "npm package builds must use bounded parallel workers" >&2
  exit 1
fi
if ! grep -Fq -- '-X main.version=$version' "$npm_package"; then
  echo "npm package builds must inject the package version" >&2
  exit 1
fi
if ! grep -Fq -- '-X main.version=#{version}' "$homebrew_formula"; then
  echo "Homebrew builds must inject the formula version" >&2
  exit 1
fi

npm_pack_count="$(grep -Ec '^[[:space:]]*npm pack ' "$npm_check")"
if [[ "$npm_pack_count" != "1" ]]; then
  echo "npm package check must create exactly one tarball, found $npm_pack_count npm pack commands" >&2
  exit 1
fi

agent_note "ok release workflow contract"
