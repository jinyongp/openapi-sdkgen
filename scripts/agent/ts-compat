#!/usr/bin/env bash
set -euo pipefail
source "$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)/scripts/agent/lib.sh"

versions=(5.7.3 5.9.3 6.0.3 7.0.2)
if [[ "${1:-all}" != "all" ]]; then
  case "$1" in
    5.7.3|5.9.3|6.0.3|7.0.2) versions=("$1") ;;
    *) echo "supported checks: all, 5.7.3, 5.9.3, 6.0.3, 7.0.2" >&2; exit 2 ;;
  esac
fi

compiler="$(mktemp "$ROOT/.tmp/typescript-compat-tsc.XXXXXX")"
trap 'rm -f "$compiler"' EXIT
export SDKGEN_COMPAT_ROOT="$ROOT"
cat >"$compiler" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
source "$SDKGEN_COMPAT_ROOT/scripts/agent/lib.sh"
ts_node node "$SDKGEN_COMPAT_TSC_PATH" "$@"
EOF
chmod 700 "$compiler"
scale_inputs="$(mktemp -d "$ROOT/.tmp/typescript-compat-scale.XXXXXX")"
trap 'rm -f "$compiler"; rm -r "$scale_inputs"' EXIT
ts_node node --input-type=module - "$scale_inputs" <<'EOF'
import fs from "node:fs";
import { sdkDeliveryDocument } from "./verification/sdk-delivery-fixture.mjs";
for (const count of [100, 1000]) fs.writeFileSync(`${process.argv[2]}/${count}.json`, JSON.stringify(sdkDeliveryDocument(count)));
EOF
skip_build=0
check_sdk() {
  local has_separator=0 argument
  for argument in "$@"; do
    if [[ "$argument" == "--" ]]; then has_separator=1; fi
  done
  if ((has_separator)); then
    "$ROOT/scripts/agent/generate-check" "$@" "--typecheck=$policy"
  else
    "$ROOT/scripts/agent/generate-check" "$@" -- "--typecheck=$policy"
  fi
}
for version in "${versions[@]}"; do
  case "$version" in
    5.7.3) package=typescript-5-7 ;;
    5.9.3) package=typescript-5-9 ;;
    6.0.3) package=typescript-6 ;;
    7.0.2) package=typescript ;;
  esac
  # generate-check invokes an executable; keep the pinned Node selection here.
  export SDKGEN_COMPAT_TSC_PATH="$TYPESCRIPT_ROOT/node_modules/$package/lib/tsc.js"
  agent_run "TypeScript $version version" "$compiler" --version
  for policy in false true; do
  agent_note "checking TypeScript $version with typecheck=$policy"
  for input in test/fixtures/support-gaps/oas32-normative.json test/fixtures/support-gaps/boundary-webhook.json test/fixtures/support-gaps/schema-array.json; do
    SDKGEN_GENERATE_CHECK_SKIP_BUILD="$skip_build" SDKGEN_GENERATE_CHECK_TSC_BIN="$compiler" \
      agent_run "TypeScript $version generated client and server: $input" \
      check_sdk "$input" typescript -- --with server
    skip_build=1
  done
  SDKGEN_GENERATE_CHECK_SKIP_BUILD=1 SDKGEN_GENERATE_CHECK_TSC_BIN="$compiler" \
    agent_run "TypeScript $version selected SDK with Link dependencies" \
    check_sdk test/fixtures/generation-selection.json typescript -- --operation getTask
  SDKGEN_GENERATE_CHECK_SKIP_BUILD=1 SDKGEN_GENERATE_CHECK_TSC_BIN="$compiler" \
    agent_run "TypeScript $version original metadata with server" \
    check_sdk test/fixtures/support-gaps/oas32-normative.json typescript -- --with server --with metadata
  SDKGEN_GENERATE_CHECK_SKIP_BUILD=1 SDKGEN_GENERATE_CHECK_TSC_BIN="$compiler" \
    agent_run "TypeScript $version selected SDK with original metadata" \
    check_sdk test/fixtures/generation-selection.json typescript -- --operation getTask --with metadata
  SDKGEN_GENERATE_CHECK_SKIP_BUILD=1 SDKGEN_GENERATE_CHECK_TSC_BIN="$compiler" \
    agent_run "TypeScript $version named clients with normative streams and XML" \
    check_sdk test/fixtures/support-gaps/oas32-normative.json typescript -- --config "$ROOT/test/fixtures/named-clients-normative.toml" --with server
  SDKGEN_GENERATE_CHECK_SKIP_BUILD=1 SDKGEN_GENERATE_CHECK_TSC_BIN="$compiler" \
    agent_run "TypeScript $version named clients with private Link dependencies and metadata" \
    check_sdk test/fixtures/generation-selection.json typescript -- --config "$ROOT/test/fixtures/named-clients-linked.toml" --operation getTask --with metadata
  SDKGEN_GENERATE_CHECK_SKIP_BUILD=1 SDKGEN_GENERATE_CHECK_TSC_BIN="$compiler" \
    agent_run "TypeScript $version named-only error codes and detail models" \
    check_sdk test/fixtures/named-clients-errors.json typescript -- --config "$ROOT/test/fixtures/named-clients-errors.toml"
  for count in 100 1000; do
    SDKGEN_GENERATE_CHECK_SKIP_BUILD=1 SDKGEN_GENERATE_CHECK_TSC_BIN="$compiler" \
      agent_run "TypeScript $version strict $count API SDK" \
      check_sdk "$scale_inputs/$count.json"
  done
  SDKGEN_GENERATE_CHECK_SKIP_BUILD=1 SDKGEN_GENERATE_CHECK_TSC_BIN="$compiler" SDKGEN_GENERATE_CHECK_MODULE_PROFILE=bundler \
    agent_run "TypeScript $version Bundler client and server" \
    check_sdk test/fixtures/support-gaps/oas32-normative.json typescript -- --with server
  SDKGEN_GENERATE_CHECK_SKIP_BUILD=1 SDKGEN_GENERATE_CHECK_TSC_BIN="$compiler" SDKGEN_GENERATE_CHECK_MODULE_PROFILE=bundler \
    agent_run "TypeScript $version Bundler named clients and metadata" \
    check_sdk test/fixtures/generation-selection.json typescript -- --config "$ROOT/test/fixtures/named-clients-linked.toml" --operation getTask --with metadata
  for module_profile in nodenext bundler commonjs; do
    for checking_profile in strict relaxed isolated relaxed-isolated; do
      # The original matrix already covers strict ESM. Add every other valid
      # combination across root, server, metadata, selected and named outputs.
      if [[ "$checking_profile" == strict && "$module_profile" != commonjs ]]; then continue; fi
      export SDKGEN_GENERATE_CHECK_MODULE_PROFILE="$module_profile"
      export SDKGEN_GENERATE_CHECK_CHECKING_PROFILE="$checking_profile"
      export SDKGEN_GENERATE_CHECK_SKIP_BUILD=1 SDKGEN_GENERATE_CHECK_TSC_BIN="$compiler"
      agent_run "TypeScript $version $module_profile $checking_profile server and metadata" \
        check_sdk test/fixtures/support-gaps/oas32-normative.json typescript -- --with server --with metadata
      agent_run "TypeScript $version $module_profile $checking_profile named Link dependencies" \
        check_sdk test/fixtures/generation-selection.json typescript -- --config "$ROOT/test/fixtures/named-clients-linked.toml" --operation getTask --with metadata
      agent_run "TypeScript $version $module_profile $checking_profile named error types" \
        check_sdk test/fixtures/named-clients-errors.json typescript -- --config "$ROOT/test/fixtures/named-clients-errors.toml"
      runtime_probe=""
      if [[ "$checking_profile" != *isolated ]]; then runtime_probe=selection; fi
      SDKGEN_GENERATE_CHECK_RUNTIME_PROBE="$runtime_probe" \
        agent_run "TypeScript $version $module_profile $checking_profile selected SDK" \
        check_sdk test/fixtures/generation-selection.json typescript -- --operation getTask
      unset SDKGEN_GENERATE_CHECK_MODULE_PROFILE SDKGEN_GENERATE_CHECK_CHECKING_PROFILE
    done
  done
  done
done
agent_note "ok TypeScript consumer compatibility (both header policies)"
