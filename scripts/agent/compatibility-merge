#!/usr/bin/env bash
set -euo pipefail
source "$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)/scripts/agent/lib.sh"

if [[ $# -lt 3 ]]; then
  echo "usage: $0 <manifest.json> <report.json> <shard-report.json>..." >&2
  exit 2
fi

manifest="$1"
output="$2"
shift 2
binary="$ROOT/.tmp/bin/openapi-sdkgen-compat-benchmark"
agent_run "build compatibility benchmark" go build -o "$binary" ./scripts/compat-benchmark
agent_run "merge compatibility reports" "$binary" \
  --mode merge --manifest "$manifest" --output "$output" "$@"
