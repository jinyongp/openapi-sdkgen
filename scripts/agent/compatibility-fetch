#!/usr/bin/env bash
set -euo pipefail
source "$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)/scripts/agent/lib.sh"

if [[ $# -ne 3 ]]; then
  echo "usage: $0 <manifest.json> <corpus-directory> <fresh|offline>" >&2
  exit 2
fi

manifest="$1"
corpus="$2"
mode="$3"
case "$mode" in
  fresh) extra=() ;;
  offline) extra=(--offline) ;;
  *)
    echo "compatibility corpus mode must be fresh or offline" >&2
    exit 2
    ;;
esac

binary="$ROOT/.tmp/bin/openapi-sdkgen-compat-benchmark"
agent_run "build compatibility benchmark" go build -o "$binary" ./scripts/compat-benchmark
agent_run "compatibility corpus $mode" "$binary"   --mode fetch   --manifest "$manifest"   --corpus-root "$corpus"   "${extra[@]}"
