type Header struct{Name,ContentType string;Explode bool;Encode BodyEncoder;Decode BodyDecoder;Schema *ParameterSchema}
func EncodeHeaders(execution *Execution,value types.Value,definitions []Header,headers http.Header)(http.Header,error){
 result:=headers.Clone();if result==nil{result=make(http.Header)}
 for _,definition:=range definitions{item,present:=value.Get(definition.Name);if !present{if raw,present:=headerPresent(result,definition.Name);present{if err:=validateRawResponseHeader(execution,raw,definition);err!=nil{return nil,err}};continue};if _,present:=headerPresent(result,definition.Name);present{return nil,fmt.Errorf("response header is provided twice")}
  var text string;var err error;contentType:=bareMedia(definition.ContentType)
  switch{case contentType=="application/json"||strings.HasSuffix(contentType,"+json"):var encoded []byte;encoded,err=item.MarshalJSON();text=string(encoded);case definition.Encode!=nil:var encoded []byte;encoded,err=definition.Encode(execution.Context,item,definition.ContentType);text=string(encoded);case contentType=="application/x-www-form-urlencoded":text=headerForm(item);case contentType!=""&&!strings.HasPrefix(contentType,"text/"):codec,present:=execution.Codec(contentType);if !present||codec.EncodeParameter==nil{return nil,fmt.Errorf("response header media codec is unavailable")};text,err=codec.EncodeParameter(execution.Context,item,types.MediaContext{ContentType:definition.ContentType,Request:execution.InboundContext().Request});default:text=headerSimple(item,definition.Explode)}
  if err!=nil{return nil,err};result.Set(definition.Name,text)
 };return result,nil
}
func headerText(value types.Value)string{if value.Kind()==types.ValueNull{return ""};return media.String(value)}
func headerSimple(value types.Value,explode bool)string{parts:=make([]string,0);switch value.Kind(){case types.ValueArray:for _,item:=range value.Items(){parts=append(parts,headerText(item))};case types.ValueObject:for _,name:=range value.Keys(){item,_:=value.Get(name);if explode{parts=append(parts,name+"="+headerText(item))}else{parts=append(parts,name,headerText(item))}};default:return headerText(value)};return strings.Join(parts,",")}
func headerForm(value types.Value)string{if value.Kind()!=types.ValueObject{return headerText(value)};pairs:=make([]string,0);for _,name:=range value.Keys(){item,_:=value.Get(name);items:=[]types.Value{item};if item.Kind()==types.ValueArray{items=item.Items()};for _,entry:=range items{text:=headerText(entry);if entry.Kind()==types.ValueArray||entry.Kind()==types.ValueObject{data,_:=entry.MarshalJSON();text=string(data)};pairs=append(pairs,url.QueryEscape(name)+"="+url.QueryEscape(text))}};return strings.Join(pairs,"&")}

func validateRawResponseHeader(execution *Execution,text string,definition Header)error{
 contentType:=bareMedia(definition.ContentType);var value types.Value;var err error
 switch{case contentType=="application/json"||strings.HasSuffix(contentType,"+json"):value,err=types.ParseValue([]byte(text));case definition.Decode!=nil:value,err=definition.Decode(execution.Context,[]byte(text),definition.ContentType);case contentType=="application/x-www-form-urlencoded":value=formObject(text);case contentType!=""&&!strings.HasPrefix(contentType,"text/"):codec,present:=execution.Codec(contentType);if !present||codec.DecodeParameter==nil{return fmt.Errorf("response header media decoder is unavailable")};value,err=codec.DecodeParameter(execution.Context,text,types.MediaContext{ContentType:definition.ContentType,Request:execution.InboundContext().Request});case contentType!="":value,err=types.ValueFrom(text);default:var raw types.Value;if definition.Schema!=nil&&definition.Schema.Kinds&ParameterObject!=0{raw,err=types.ValueFrom(parameterObject(text,Parameter{Explode:definition.Explode,Style:"simple"}))}else{raw,err=types.ValueFrom([]string{text})};if err==nil{value,err=CoerceParameter(execution.Context,definition.Schema,raw,true)}}
 if err!=nil{return err};if definition.Schema!=nil&&definition.Schema.Validate!=nil{return definition.Schema.Validate(execution.Context,value)};return nil
}
