func canonicalHeader(headers http.Header,name,value string){for key:=range headers{if strings.EqualFold(key,name){delete(headers,key)}};headers.Set(name,value)}
type flushingWriter struct{writer http.ResponseWriter;controller *http.ResponseController}
func(writer *flushingWriter)Write(value []byte)(int,error){count,err:=writer.writer.Write(value);if err==nil&&count!=0{err=writer.controller.Flush()};return count,err}
func supportsFlush(writer http.ResponseWriter)bool{for{switch value:=writer.(type){case interface{FlushError()error}:return true;case http.Flusher:return true;case interface{Unwrap()http.ResponseWriter}:writer=value.Unwrap();default:return false}}}
