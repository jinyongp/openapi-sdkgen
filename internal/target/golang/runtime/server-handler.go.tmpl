type Route struct{Path,Method string;Handler http.Handler}
type inboundHandler struct{path string;pattern *regexp.Regexp;names []string;definition Definition;options Options;invoke Invocation}
func NewHandler(path string,definition Definition,options Options,invoke Invocation)(http.Handler,error){
