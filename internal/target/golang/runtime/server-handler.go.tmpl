func matchRoute(pattern *regexp.Regexp,names []string,path string)(map[string]string,bool){parts:=strings.Split(path,"/");for index,part:=range parts{decoded,err:=url.PathUnescape(part);if err!=nil{return nil,false};parts[index]=url.PathEscape(decoded)};matches:=pattern.FindStringSubmatch(strings.Join(parts,"/"));if matches==nil{return nil,false};result:=make(map[string]string,len(names));for index,name:=range names{value,err:=url.PathUnescape(matches[index+1]);if err!=nil{return nil,false};result[name]=value};return result,true}
