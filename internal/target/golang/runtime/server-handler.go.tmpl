 if flush&&!supportsFlush(writer){return fail(&types.SDKError{Code:types.TransportCapabilityRequired,Message:"inbound streaming response requires flushing"})}
 if requireDuplex{if err:=http.NewResponseController(writer).EnableFullDuplex();err!=nil{return fail(&types.SDKError{Code:types.TransportCapabilityRequired,Message:"inbound bidirectional streaming requires full duplex",Cause:err})}}
 var body io.ReadCloser;expectedLength:=int64(0);hasLength:=false
 if value,present:=headerPresent(headers,"Content-Length");present{length,err:=strconv.ParseInt(value,10,64);if err!=nil||length<0{return fail(fmt.Errorf("response content length is invalid"))};expectedLength,hasLength=length,true;canonicalHeader(headers,"Content-Length",value)}
 if response.HasBody{
  if err:=response.Body.Validate();err!=nil{return fail(err)};metadata:=response.Body.Metadata()
  if value,present:=headerPresent(headers,"Content-Type");present{actual,parameters,err:=mime.ParseMediaType(value);if err!=nil||strings.Contains(actual,"*"){return fail(fmt.Errorf("response content type is invalid"))};if metadata.ContentType!=""{declared,expected,err:=mime.ParseMediaType(metadata.ContentType);if err!=nil||!strings.EqualFold(actual,declared)||expected["boundary"]!=""&&parameters["boundary"]!=expected["boundary"]{return fail(fmt.Errorf("response content type conflicts with body"))}};canonicalHeader(headers,"Content-Type",value)
  }else if metadata.ContentType!=""{actual,_,err:=mime.ParseMediaType(metadata.ContentType);if err!=nil||strings.Contains(actual,"*"){return fail(fmt.Errorf("response content type is invalid"))};headers.Set("Content-Type",metadata.ContentType)}
