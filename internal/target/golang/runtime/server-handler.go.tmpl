func validateInboundDefinition(definition Definition)error{if !validHeaderName(definition.Method){return fmt.Errorf("inbound method must be an HTTP token")};security:=definition.Security;if security.Kind()==types.ValueNull{return nil};if security.Kind()!=types.ValueArray{return fmt.Errorf("inbound security must be an array")};for _,requirement:=range security.Items(){if requirement.Kind()!=types.ValueObject{return fmt.Errorf("inbound security requirement must be an object")};for _,name:=range requirement.Keys(){scopes,_:=requirement.Get(name);if name==""||scopes.Kind()!=types.ValueArray{return fmt.Errorf("inbound security scopes must be an array")};for _,scope:=range scopes.Items(){if _,ok:=scope.String();!ok{return fmt.Errorf("inbound security scope must be a string")}}}};return nil}
var emptyInboundParameters=func()types.Value{value,_:=types.ParseValue([]byte(`{"path":{},"query":{},"querystring":{},"header":{},"cookie":{}}`));return value}()
func normalizeParameters(value types.Value)(types.Value,error){if value.Kind()==types.ValueNull{return emptyInboundParameters,nil};if value.Kind()!=types.ValueObject{return types.Value{},fmt.Errorf("inbound parameters must be grouped objects")};fields:=make(map[string]types.Value,5);for _,name:=range []string{"path","query","querystring","header","cookie"}{section,present:=value.Get(name);if !present{section,_=emptyInboundParameters.Get(name)};if section.Kind()!=types.ValueObject{return types.Value{},fmt.Errorf("inbound parameter section must be an object")};fields[name]=section};return types.ValueFrom(fields)}
func InputError(cause error)error{if cause==nil{return nil};return inputFailure(cause)}
func HandlerError(cause error)error{if cause==nil{return nil};var existing *Error;if errors.As(cause,&existing){return cause};return &Error{Status:500,Code:InboundHandlerFailed,Cause:cause}}
func ResponseError(cause error)error{if cause==nil{return nil};var existing *Error;if errors.As(cause,&existing){return cause};return &Error{Status:500,Code:InboundResponseInvalid,Cause:cause}}
func requiresAuthentication(value types.Value)bool{if value.Kind()!=types.ValueArray||value.Len()==0{return false};for index:=0;index<value.Len();index++{requirement,_:=value.At(index);if requirement.Kind()==types.ValueObject&&requirement.Len()==0{return false}};return true}
func Send(ctx context.Context,writer http.ResponseWriter,response Response,requireDuplex bool)(sent bool,failure error){
