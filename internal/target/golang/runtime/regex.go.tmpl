// Pattern holds a generation-time compiled immutable ECMAScript Unicode program.
// Matcher failures remain distinct from a schema mismatch.
type Pattern struct { compiled *ecmaregexp.Program }
func (pattern *Pattern) Match(ctx context.Context,value string) (bool,error) {
    matched,err:=pattern.compiled.Match(ctx,value)
    if errors.Is(err,ecmaregexp.ErrComplexity){return false,&wire.ValidationLimitError{Cause:err}}
    return matched,err
}
