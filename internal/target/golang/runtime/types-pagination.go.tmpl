   limit:=paginationNumber(page,source.config.ResponseLimit,paginationNumber(source.query,[]string{source.config.Limit},float64(source.page.Len())))
   total,totalPresent:=paginationPointer(page,source.config.Total);totalNumber,totalIsNumber:=total.Number()
   next:=offset+limit
   if source.config.Offset==""||limit<=0||source.page.Kind()!=ValueArray||source.page.Len()==0||float64(source.page.Len())<limit||next<=requested||source.offsets[next]||(totalPresent&&totalIsNumber&&next>=totalNumber){source.finished=true}else{source.offsets[next]=true;fields[source.config.Offset],err=ValueFrom(next)}
