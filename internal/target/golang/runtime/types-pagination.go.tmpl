func(source *paginationSource[T])Item()T{source.mu.Lock();defer source.mu.Unlock();return source.item}
func(source *paginationSource[T])Err()error{source.mu.Lock();defer source.mu.Unlock();return source.failure}
// The outer stream cancels active HTTP before Close waits for the current Next.
func(source *paginationSource[T])Close()error{source.mu.Lock();defer source.mu.Unlock();source.closed=true;source.page=Value{};source.query=Value{};source.cursors=nil;source.offsets=nil;source.fetch=nil;source.decode=nil;var zero T;source.item=zero;return nil}
func paginationPointer(value Value,tokens []string)(Value,bool){
