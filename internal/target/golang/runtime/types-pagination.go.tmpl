  if value,present:=query.Get(config.Cursor);present{if text,ok:=value.String();ok{source.cursors[text]=true}}
  if value,present:=query.Get(config.Offset);present{if number,ok:=value.Number();ok{source.offsets[number]=true}}
  return source,nil,nil
 })}
}
type paginationSource[T any]struct{
 mu sync.Mutex
 closed bool
 ctx context.Context
 config PaginationConfig
 mode string
 query,page Value
 index int
