// CloneOptions is shared by request construction and execution. DTOs and byte
// buffers remain host-owned; only SDK option containers are copied.
func CloneOptions(options types.RequestOptions) types.RequestOptions {
    options.Headers=cloneHeader(options.Headers)
    if options.StreamCodec!=nil{codec:=*options.StreamCodec;options.StreamCodec=&codec}
    var headers map[string]http.Header;if options.MultipartHeaders!=nil{headers=make(map[string]http.Header,len(options.MultipartHeaders))}
    for name,value:=range options.MultipartHeaders{headers[name]=cloneHeader(value)}
    options.MultipartHeaders=headers
    var contentTypes map[string]string;if options.MultipartContentTypes!=nil{contentTypes=make(map[string]string,len(options.MultipartContentTypes))}
    for name,value:=range options.MultipartContentTypes{contentTypes[name]=value}
    options.MultipartContentTypes=contentTypes
