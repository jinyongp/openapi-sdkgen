func multipartToken(value string)string{return strings.NewReplacer("\\","\\\\","\"","\\\"").Replace(wire.USVString(value))}
func multipartCustomMedia(value string)bool{value=bareMedia(value);return value!="application/json"&&!strings.HasSuffix(value,"+json")&&!isXML(value)&&!strings.HasPrefix(value,"text/")&&value!="application/x-www-form-urlencoded"&&value!="application/octet-stream"&&!strings.HasPrefix(value,"image/")&&!strings.HasPrefix(value,"audio/")&&!strings.HasPrefix(value,"video/")}
func multipartContentType(declared,candidate string,explicit bool,fallback,binaryMedia string)(string,error){
