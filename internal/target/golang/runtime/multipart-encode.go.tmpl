func BoundPart(part media.MultipartPart,maximum int)(media.MultipartPart,error){
    if err:=part.Body.Validate();err!=nil{return media.MultipartPart{},err}
    if size,known:=part.Body.Metadata().Size.Get();known&&size>int64(maximum){return media.MultipartPart{},&types.StreamFrameError{Kind:"limit",Maximum:maximum}}
