type boundedPartSource struct{body types.Binary;maximum int}
func(source *boundedPartSource)Metadata()types.BinaryMetadata{return source.body.Metadata()}
func(source *boundedPartSource)Open(ctx context.Context)(io.ReadCloser,error){reader,err:=source.body.Open(ctx);if err!=nil{return nil,err};return &boundedPartReader{ReadCloser:reader,maximum:source.maximum},nil}
type boundedPartReader struct{io.ReadCloser;maximum,read int}
func(reader *boundedPartReader)Read(buffer []byte)(int,error){
