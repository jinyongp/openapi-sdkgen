func matchesMedia(actual,pattern string)bool{actual=bareMedia(actual);pattern=bareMedia(pattern);if actual==pattern{return true};left,right:=strings.SplitN(pattern,"/",2),strings.SplitN(actual,"/",2);if len(left)!=2||len(right)!=2||left[0]!="*"&&left[0]!=right[0]{return false};return left[1]=="*"||strings.HasPrefix(left[1],"*+")&&strings.HasSuffix(right[1],left[1][1:])}

func(encoder Encoder)Item(ctx context.Context,value types.MultipartData,index int,definitions []media.FormField)(media.MultipartPart,error){
