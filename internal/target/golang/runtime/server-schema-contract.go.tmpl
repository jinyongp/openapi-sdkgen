func checkNormalizedSchema(raw types.Value)error{
 if raw.Kind()==types.ValueBoolean{return nil};if raw.Kind()!=types.ValueObject{return fmt.Errorf("normalized schema must be an object or boolean")}
 for _,key:=range []string{"type","$ref","$dynamicRef","$defs","definitions","const","enum"}{if _,present:=raw.Get(key);present{return fmt.Errorf("schema contains source keyword %q; normalized keywords are required",key)}}
 for _,key:=range []string{"reference","dynamicAnchor","pattern","format","contentEncoding","contentMediaType","binaryContentType"}{if value,present:=raw.Get(key);present{if text,ok:=value.String();!ok||(key=="reference"||key=="dynamicAnchor")&&text==""{return fmt.Errorf("normalized %s must be a string",key)}}}
 for _,key:=range []string{"boolean","formatAssertion","uniqueItems","binaryInput","binaryNullable","ignoreContentMediaType"}{if value,present:=raw.Get(key);present{if _,ok:=value.Bool();!ok{return fmt.Errorf("normalized %s must be a boolean",key)}}}
 for _,key:=range []string{"multipleOf","maximum","minimum","exclusiveMaximum","exclusiveMinimum","minLength","maxLength","minItems","maxItems","minContains","maxContains","minProperties","maxProperties"}{if value,present:=raw.Get(key);present{number,ok:=value.Number();if !ok{return fmt.Errorf("normalized %s must be a number",key)};if key=="multipleOf"&&number<=0{return fmt.Errorf("multipleOf must be positive")};if key!="minimum"&&key!="maximum"&&key!="exclusiveMinimum"&&key!="exclusiveMaximum"&&key!="multipleOf"&&(number<0||!schema.IsInteger(value)){return fmt.Errorf("normalized %s must be a nonnegative integer",key)}}}
 stringsArray:=func(value types.Value)bool{if value.Kind()!=types.ValueArray{return false};for _,item:=range value.Items(){if _,ok:=item.String();!ok{return false}};return true}
 if value,present:=raw.Get("required");present&&!stringsArray(value){return fmt.Errorf("normalized required must be an array of strings")}
 if value,present:=raw.Get("types");present{if !stringsArray(value){return fmt.Errorf("normalized types must be an array of strings")};for _,item:=range value.Items(){text,_:=item.String();switch text{case "null","boolean","string","number","integer","array","object":default:return fmt.Errorf("unknown normalized type %q",text)}}}
 if value,present:=raw.Get("enumValues");present&&value.Kind()!=types.ValueArray{return fmt.Errorf("normalized enumValues must be an array")}
 if value,present:=raw.Get("dependentRequired");present{if value.Kind()!=types.ValueObject{return fmt.Errorf("normalized dependentRequired must be an object")};for _,name:=range value.Keys(){items,_:=value.Get(name);if !stringsArray(items){return fmt.Errorf("normalized dependency must be an array of strings")}}}
 if value,present:=raw.Get("xml");present{if value.Kind()!=types.ValueObject{return fmt.Errorf("normalized xml must be an object")};for _,key:=range []string{"name","prefix","namespace","nodeType"}{if item,present:=value.Get(key);present{if _,ok:=item.String();!ok{return fmt.Errorf("normalized XML %s must be a string",key)}}};for _,key:=range []string{"attribute","wrapped"}{if item,present:=value.Get(key);present{if _,ok:=item.Bool();!ok{return fmt.Errorf("normalized XML %s must be boolean",key)}}}}
 return nil
}
