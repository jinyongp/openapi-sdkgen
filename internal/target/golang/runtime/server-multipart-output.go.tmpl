func(execution *Execution)multipartEncoder()multipartcodec.Encoder{return multipartcodec.Encoder{Options:types.RequestOptions{MultipartHeaders:execution.ResponseMultipart.Headers,MultipartContentTypes:execution.ResponseMultipart.ContentTypes},Encode:func(ctx context.Context,value types.Value,contentType string)(types.Binary,error){return EncodeBodyContext(ctx,execution,value,contentType,responseMediaKind(contentType),nil,nil)}}}
func responseMediaKind(contentType string)string{bare:=bareMedia(contentType);switch{case bare=="application/json"||strings.HasSuffix(bare,"+json"):return "json";case strings.HasPrefix(bare,"text/"):return "text";default:return "custom"}}
func EncodeMultipartBody(execution *Execution,contentType string,value types.MultipartData,definitions []FormField,bounded bool)(types.Binary,error){parts,err:=execution.multipartEncoder().Parts(execution.Context,value,definitions,true);if err!=nil{return types.Binary{},err};if bounded{for index,part:=range parts{parts[index],err=multipartcodec.BoundPart(part,execution.Options.MaxStreamFrameBytes);if err!=nil{return types.Binary{},err}}};return media.EncodeMultipart(contentType,parts)}
func EncodeMultipartSource[T any](execution *Execution,contentType string,source types.Source[T],encode func(context.Context,T)(types.MultipartData,error),definitions []FormField)(types.Binary,error){
 if source==nil{return types.Binary{},fmt.Errorf("response source is nil")};owned:=&ownedSource[T]{Source:source};if err:=execution.Own(owned);err!=nil{return types.Binary{},err};contentType,err:=stream.MultipartContentType(contentType);if err!=nil{return types.Binary{},err};encoder:=execution.multipartEncoder()
 if execution.StreamCodec(contentType).IsZero(){factory:=func(ctx context.Context)(types.Source[media.MultipartPart],error){index:=0;return types.MapSource(ctx,owned,func(ctx context.Context,item T)(media.MultipartPart,error){value,err:=encode(ctx,item);if err!=nil{return media.MultipartPart{},err};part,err:=encoder.Item(ctx,value,index,definitions);index++;if err!=nil{return media.MultipartPart{},err};return multipartcodec.BoundPart(part,execution.Options.MaxStreamFrameBytes)}),nil};return media.EncodeMultipartSource(contentType,factory)}
 return types.BinaryFromSource(&multipartResponseStream[T]{execution:execution,contentType:contentType,source:owned,encode:encode,definitions:definitions}),nil
}
type multipartResponseStream[T any]struct{execution *Execution;contentType string;source types.Source[T];encode func(context.Context,T)(types.MultipartData,error);definitions []FormField}
func(body *multipartResponseStream[T])Metadata()types.BinaryMetadata{return types.BinaryMetadata{ContentType:body.contentType}}
func(body *multipartResponseStream[T])Open(ctx context.Context)(io.ReadCloser,error){index:=0;encoder:=body.execution.multipartEncoder();toFrame:=func(ctx context.Context,value types.MultipartData)(types.MultipartPart,error){frame,err:=encoder.Frame(ctx,value,index,body.definitions,body.execution.Options.MaxStreamFrameBytes);index++;return frame,err};validate:=func(ctx context.Context,item T)(T,error){_,err:=body.encode(ctx,item);return item,err};return types.EncodeStreamMediaData(ctx,body.execution.StreamCodec(body.contentType),stream.MultipartProtocol{},body.source,body.execution.StreamContext(body.contentType),body.encode,toFrame,validate)}
