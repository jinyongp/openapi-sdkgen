type MultipartHeader struct{Name string;Required bool;Decode func(context.Context,string)(types.Value,error)}
type FormField struct { Name,Key,Style,ContentType,DefaultContentType,BinaryContentType string; StyleBased,AllowReserved,Explode,Positional,Default bool; Headers []MultipartHeader;Children []FormField;Nested func(string,string)[]FormField;Encoder func(context.Context,types.Value,string,string,string)(types.Binary,error);MediaInfo func(context.Context,types.Value,string,string,map[string]bool)(string,bool,error) }

// EncodeFormBody keeps content-based and explicitly style-based fields distinct.
func EncodeFormBody(value types.Value,definitions []FormField)(types.Binary,error){
 if value.Kind()!=types.ValueObject{return types.Binary{},fmt.Errorf("form body must be an object")}
 var pairs []string
 for _,name:=range value.Keys(){
  item,_:=value.Get(name);definition:=FormField{}
  for _,candidate:=range definitions{if candidate.Name==name{definition=candidate;break}}
  if definition.StyleBased{
   encode:=func(text string)string{return EncodeQueryValue(text,definition.AllowReserved)}
   pair:=func(key,text string){pairs=append(pairs,EncodeQueryValue(key,false)+"="+encode(text))}
   style:=definition.Style;if style==""{style="form"}
   if style=="deepObject"&&item.Kind()==types.ValueObject{for _,key:=range item.Keys(){entry,_:=item.Get(key);pair(name+"["+key+"]",String(entry))};continue}
   if definition.Explode&&style=="form"{switch item.Kind(){case types.ValueArray:for _,entry:=range item.Items(){pair(name,String(entry))};continue;case types.ValueObject:for _,key:=range item.Keys(){entry,_:=item.Get(key);pair(key,String(entry))};continue}}
   separator:=",";if style=="pipeDelimited"{separator="%7C"};if style=="spaceDelimited"{separator="%20"}
   var parts []string
   switch item.Kind(){case types.ValueArray:for _,entry:=range item.Items(){parts=append(parts,encode(String(entry)))};case types.ValueObject:for _,key:=range item.Keys(){entry,_:=item.Get(key);if definition.Explode{parts=append(parts,encode(key)+"="+encode(String(entry)))}else{parts=append(parts,encode(key),encode(String(entry)))}};default:parts=append(parts,encode(String(item)))}
   pairs=append(pairs,EncodeQueryValue(name,false)+"="+strings.Join(parts,separator));continue
  }
  contentType:=definition.ContentType;if contentType==""{contentType=definition.DefaultContentType}
  media,_,_:=strings.Cut(strings.ToLower(contentType),";");media=strings.TrimSpace(media)
  json:=media=="application/json"||strings.HasSuffix(media,"+json")
  if media==""{json=item.Kind()==types.ValueObject;for _,entry:=range item.Items(){json=json||entry.Kind()==types.ValueObject}}
  pair:=func(text string){pairs=append(pairs,formEscape(name)+"="+formEscape(text))}
  if json{encoded,err:=item.MarshalJSON();if err!=nil{return types.Binary{},err};pair(string(encoded))}else if item.Kind()==types.ValueArray{for _,entry:=range item.Items(){pair(String(entry))}}else{pair(String(item))}
 }
 return types.BinaryFromBytes([]byte(strings.Join(pairs,"&"))),nil
}
