func CollectStream[T any](ctx context.Context,source types.Source[T],encode func(context.Context,T)(types.Value,error))(value types.Value,failure error){
    defer func(){failure=errors.Join(failure,source.Close())}()
    values:=make([]types.Value,0)
    for source.Next(){item,err:=encode(ctx,source.Item());if err!=nil{return types.Value{},err};values=append(values,item)}
