// Schema is a compiled normalized wire schema. It is independent of generated
// models and is safe to share between concurrent requests. Compilation never
// resolves URLs or executes compiler extensions or embedded program objects.
type Schema struct{root *normalizedNode;definitions map[string]*normalizedNode;nodes map[*ParameterSchema]*normalizedNode}
type normalizedNode struct{
 raw types.Value
 children map[string]*normalizedNode
 lists map[string][]*normalizedNode
 maps map[string]map[string]*normalizedNode
 pattern *schema.Pattern
 patterns map[string]*schema.Pattern
 shape *ParameterSchema
}
type normalizedVisit struct{node *normalizedNode;path string}
type normalizedState struct{active map[normalizedVisit]bool;scope []*normalizedNode}
func normalizedText(value types.Value,key string)string{item,_:=value.Get(key);text,_:=item.String();return text}
func normalizedFlag(value types.Value,key string)bool{item,_:=value.Get(key);flag,_:=item.Bool();return flag}
// CompileSchema accepts normalized keywords such as types, reference and
// constValue. A property's schema may be direct or a {property,schema} view.
func CompileSchema(root types.Value,definitions map[string]types.Value)(*Schema,error){
 result:=&Schema{definitions:make(map[string]*normalizedNode),nodes:make(map[*ParameterSchema]*normalizedNode)};var err error
 for _,name:=range normalizedKeys(definitions){result.definitions[name],err=compileNormalizedNode(definitions[name]);if err!=nil{return nil,err}}
 result.root,err=compileNormalizedNode(root);if err!=nil{return nil,err}
 visited:=make(map[*normalizedNode]bool);var bind func(*normalizedNode)error
 bind=func(node *normalizedNode)error{if node==nil||visited[node]{return nil};visited[node]=true
  node.shape=&ParameterSchema{Validate:func(ctx context.Context,value types.Value)error{_,err:=result.validate(ctx,node,value,"",&normalizedState{active:make(map[normalizedVisit]bool)});return err}}
  result.nodes[node.shape]=node
  for _,child:=range node.children{if err:=bind(child);err!=nil{return err}};for _,children:=range node.lists{for _,child:=range children{if err:=bind(child);err!=nil{return err}}};for _,children:=range node.maps{for _,child:=range children{if err:=bind(child);err!=nil{return err}}}
  if reference:=normalizedText(node.raw,"reference");reference!=""{target,present:=result.definitions[reference];if !present{return fmt.Errorf("missing normalized schema reference %q",reference)};if err:=bind(target);err!=nil{return err};node.shape.Reference=target.shape}
  kinds,_:=node.raw.Get("types");for _,kind:=range kinds.Items(){text,_:=kind.String();switch text{case "string":node.shape.Kinds|=ParameterString;case "boolean":node.shape.Kinds|=ParameterBoolean;case "number","integer":node.shape.Kinds|=ParameterNumber;case "object":node.shape.Kinds|=ParameterObject;case "array":node.shape.Kinds|=ParameterArray}}
  literals,_:=node.raw.Get("enumValues");literalValues:=literals.Items();if literal,present:=node.raw.Get("constValue");present{literalValues=append(literalValues,literal)};for _,literal:=range literalValues{switch literal.Kind(){case types.ValueString:node.shape.Kinds|=ParameterString;case types.ValueBoolean:node.shape.Kinds|=ParameterBoolean;case types.ValueNumber:node.shape.Kinds|=ParameterNumber;case types.ValueArray:node.shape.Kinds|=ParameterArray;case types.ValueObject:node.shape.Kinds|=ParameterObject}}
  for _,key:=range []string{"items","prefixItems","contains","minItems","maxItems","uniqueItems"}{if _,present:=node.raw.Get(key);present{node.shape.Kinds|=ParameterArray}};for _,key:=range []string{"required","minProperties","maxProperties","properties","patternProperties","additionalProperties"}{if _,present:=node.raw.Get(key);present{node.shape.Kinds|=ParameterObject}}
  node.shape.Properties=make(map[string]*ParameterSchema);for name,child:=range node.maps["properties"]{node.shape.Properties[name]=child.shape};if len(node.shape.Properties)>0||node.children["additionalProperties"]!=nil||len(node.patterns)>0{node.shape.Kinds|=ParameterObject}
  for _,name:=range normalizedKeys(node.patterns){node.shape.Patterns=append(node.shape.Patterns,ParameterPattern{Match:node.patterns[name].Match,Schema:node.maps["patternProperties"][name].shape})}
  for _,field:=range []struct{key string;target **ParameterSchema}{ {"additionalProperties",&node.shape.Additional},{"items",&node.shape.Items},{"then",&node.shape.Then},{"else",&node.shape.Else},{"dynamicFallback",&node.shape.DynamicFallback} }{if child:=node.children[field.key];child!=nil{*field.target=child.shape}}
  for _,field:=range []struct{key string;target *[]*ParameterSchema}{ {"allOf",&node.shape.AllOf},{"oneOf",&node.shape.OneOf},{"anyOf",&node.shape.AnyOf},{"prefixItems",&node.shape.PrefixItems} }{if children,present:=node.lists[field.key];present{*field.target=make([]*ParameterSchema,len(children));for index,child:=range children{(*field.target)[index]=child.shape}}};node.shape.Conditional=node.children["if"]!=nil
  return nil
 };if err:=bind(result.root);err!=nil{return nil,err};for _,name:=range normalizedKeys(result.definitions){if err:=bind(result.definitions[name]);err!=nil{return nil,err}};return result,nil
}
func normalizedKeys[T any](values map[string]T)[]string{keys:=make([]string,0,len(values));for key:=range values{keys=append(keys,key)};sort.Strings(keys);return keys}
func compileNormalizedNode(raw types.Value)(*normalizedNode,error){
 if err:=checkNormalizedSchema(raw);err!=nil{return nil,err}
 if raw.Kind()!=types.ValueObject&&raw.Kind()!=types.ValueBoolean{return nil,fmt.Errorf("normalized schema must be an object or boolean")};node:=&normalizedNode{raw:raw,children:make(map[string]*normalizedNode),lists:make(map[string][]*normalizedNode),maps:make(map[string]map[string]*normalizedNode),patterns:make(map[string]*schema.Pattern)}
 for _,key:=range []string{"items","additionalProperties","unevaluatedProperties","unevaluatedItems","contains","propertyNames","if","then","else","not","contentSchema"}{if value,present:=raw.Get(key);present{child,err:=compileNormalizedNode(value);if err!=nil{return nil,fmt.Errorf("%s: %w",key,err)};node.children[key]=child}}
 if dynamic,present:=raw.Get("dynamicReference");present{fallback,present:=dynamic.Get("fallback");if !present||normalizedText(dynamic,"anchor")==""{return nil,fmt.Errorf("invalid normalized dynamic reference")};child,err:=compileNormalizedNode(fallback);if err!=nil{return nil,err};node.children["dynamicFallback"]=child}
 for _,key:=range []string{"allOf","oneOf","anyOf","prefixItems"}{if value,present:=raw.Get(key);present{if value.Kind()!=types.ValueArray{return nil,fmt.Errorf("%s must be an array",key)};node.lists[key]=make([]*normalizedNode,value.Len());for index,item:=range value.Items(){child,err:=compileNormalizedNode(item);if err!=nil{return nil,err};node.lists[key][index]=child}}}
 for _,key:=range []string{"properties","patternProperties","dependentSchemas"}{if value,present:=raw.Get(key);present{if value.Kind()!=types.ValueObject{return nil,fmt.Errorf("%s must be an object",key)};node.maps[key]=make(map[string]*normalizedNode);for _,name:=range value.Keys(){item,_:=value.Get(name);if key=="properties"{if nested,present:=item.Get("schema");present{item=nested}};child,err:=compileNormalizedNode(item);if err!=nil{return nil,err};node.maps[key][name]=child;if key=="patternProperties"{pattern,err:=schema.PreparePattern(name);if err!=nil{return nil,err};node.patterns[name]=pattern}}}}
 if pattern,present:=raw.Get("pattern");present{text,ok:=pattern.String();if !ok{return nil,fmt.Errorf("pattern must be a string")};pattern,err:=schema.PreparePattern(text);if err!=nil{return nil,err};node.pattern=pattern};return node,nil
}
func(contract *Schema)Validate(ctx context.Context,value types.Value)error{if contract==nil||contract.root==nil{return fmt.Errorf("schema is nil")};_,err:=contract.validate(ctx,contract.root,value,"",&normalizedState{active:make(map[normalizedVisit]bool)});return err}
func(contract *Schema)Decode(ctx context.Context,data []byte)(types.Value,error){value,err:=media.DecodeJSON(data);if err!=nil{return types.Value{},err};if err:=contract.Validate(ctx,value);err!=nil{return types.Value{},err};return value,nil}
func(contract *Schema)DecodeInbound(execution *Execution,contentType,kind string)(types.Value,error){if contract==nil||contract.root==nil{return types.Value{},inputFailure(fmt.Errorf("schema is nil"))};var decoder BodyDecoder;if isXMLMedia(contentType){decoder=func(ctx context.Context,data []byte,_ string)(types.Value,error){return contract.DecodeXML(ctx,data)}};value,err:=DecodeBody(execution,contentType,kind,contract.root.shape,decoder);if err!=nil{return types.Value{},err};if err:=contract.Validate(execution.Context,value);err!=nil{return types.Value{},inputFailure(err)};return value,nil}
func(contract *Schema)Respond(execution *Execution,status int,contentType,kind string,value types.Value)(Response,error){if status<200||status>599||status==204||status==205||status==304{return Response{},ResponseError(fmt.Errorf("response status forbids this body"))};if err:=contract.Validate(execution.Context,value);err!=nil{return Response{},ResponseError(err)};var encoder BodyEncoder;if isXMLMedia(contentType){encoder=func(ctx context.Context,value types.Value,_ string)([]byte,error){return contract.EncodeXML(ctx,value)}};body,err:=EncodeBody(execution,value,contentType,kind,encoder,nil);if err!=nil{return Response{},ResponseError(err)};return Response{Status:status,Body:body,HasBody:true},nil}
func(contract *Schema)validate(ctx context.Context,node *normalizedNode,value types.Value,path string,state *normalizedState)(schema.Evaluation,error){
 result:=schema.NewEvaluation();if err:=ctx.Err();err!=nil{return result,err};if node==nil{return result,nil};visit:=normalizedVisit{node:node,path:path};if state.active[visit]{return result,fmt.Errorf("schema recursion made no progress")};state.active[visit]=true;defer delete(state.active,visit)
 fail:=func(keyword string)(schema.Evaluation,error){return result,schema.Failure(keyword,path)}
 if accepted,ok:=node.raw.Bool();ok{if !accepted{return fail("false")};return result,nil};if flag,present:=node.raw.Get("boolean");present{if accepted,ok:=flag.Bool();ok&&!accepted{return fail("false")}}
 if normalizedFlag(node.raw,"binaryInput")&&value.Kind()!=types.ValueString&&!(normalizedFlag(node.raw,"binaryNullable")&&value.Kind()==types.ValueNull){return fail("binary input")}
 if normalizedText(node.raw,"dynamicAnchor")!=""{state.scope=append(state.scope,node);defer func(){state.scope=state.scope[:len(state.scope)-1]}()}
 merge:=func(child *normalizedNode)error{evaluated,err:=contract.validate(ctx,child,value,path,state);if err==nil{schema.Merge(&result,evaluated)};return err}
 if reference:=normalizedText(node.raw,"reference");reference!=""{if err:=merge(contract.definitions[reference]);err!=nil{return result,err}}
 if fallback:=node.children["dynamicFallback"];fallback!=nil{dynamic,_:=node.raw.Get("dynamicReference");anchor:=normalizedText(dynamic,"anchor");target:=fallback;for _,binding:=range state.scope{if normalizedText(binding.raw,"dynamicAnchor")==anchor{target=binding;break}};if err:=merge(target);err!=nil{return result,err}}
 if kinds,present:=node.raw.Get("types");present{accepted:=false;for _,kind:=range kinds.Items(){text,_:=kind.String();switch text{case "null":accepted=accepted||value.Kind()==types.ValueNull;case "boolean":accepted=accepted||value.Kind()==types.ValueBoolean;case "string":accepted=accepted||value.Kind()==types.ValueString;case "number":accepted=accepted||value.Kind()==types.ValueNumber;case "integer":accepted=accepted||schema.IsInteger(value);case "array":accepted=accepted||value.Kind()==types.ValueArray;case "object":accepted=accepted||value.Kind()==types.ValueObject}};if !accepted{return fail("type")}}
 if expected,present:=node.raw.Get("constValue");present&&!value.Equal(expected){return fail("constValue")};if expected,present:=node.raw.Get("enumValues");present{accepted:=false;for _,candidate:=range expected.Items(){accepted=accepted||value.Equal(candidate)};if !accepted{return fail("enumValues")}}
 if number,ok:=value.Number();ok{for _,keyword:=range []string{"minimum","maximum","exclusiveMinimum","exclusiveMaximum","multipleOf"}{limit,present:=node.raw.Get(keyword);if !present{continue};bound,valid:=limit.Number();if !valid{return result,fmt.Errorf("invalid normalized numeric bound")};invalid:=false;switch keyword{case "minimum":invalid=number<bound;case "maximum":invalid=number>bound;case "exclusiveMinimum":invalid=number<=bound;case "exclusiveMaximum":invalid=number>=bound;case "multipleOf":invalid=!schema.MultipleOf(value,bound)};if invalid{return fail(keyword)}}}
 for _,bound:=range []struct{minimum,maximum string;kind types.ValueKind}{ {"minLength","maxLength",types.ValueString},{"minItems","maxItems",types.ValueArray},{"minProperties","maxProperties",types.ValueObject} }{if value.Kind()!=bound.kind{continue};for _,keyword:=range []string{bound.minimum,bound.maximum}{limit,present:=node.raw.Get(keyword);if !present{continue};number,ok:=limit.Number();if !ok{return result,fmt.Errorf("invalid normalized length bound")};if keyword==bound.minimum&&float64(value.Len())<number||keyword==bound.maximum&&float64(value.Len())>number{return fail(keyword)}}}
 if text,ok:=value.String();ok{if node.pattern!=nil{matched,err:=node.pattern.Match(ctx,text);if err!=nil{return result,err};if !matched{return fail("pattern")}};if normalizedFlag(node.raw,"formatAssertion"){if err:=validateNormalizedFormat(ctx,value,normalizedText(node.raw,"format"));err!=nil{return result,err}};if child:=node.children["contentSchema"];child!=nil{contentType:=normalizedText(node.raw,"contentMediaType");mediaType:=contentType;if isXMLMedia(contentType){mediaType=""};content,err:=schema.DecodeContent(text,normalizedText(node.raw,"contentEncoding"),mediaType,path);if err!=nil{return result,err};if isXMLMedia(contentType){decoded,_:=content.String();xml,err:=wire.ParseXML(ctx,decoded);if err!=nil{return result,schema.Failure("contentMediaType",path)};content,err=contract.decodeXMLNode(ctx,child,xml);if err!=nil{return result,err}};if _,err:=contract.validate(ctx,child,content,schema.ChildPath(path,"$content"),state);err!=nil{return result,err}}}
 for _,keyword:=range []string{"allOf","oneOf","anyOf"}{children,present:=node.lists[keyword];if !present{continue};matches:=0;combined:=schema.NewEvaluation();for _,child:=range children{evaluated,err:=contract.validate(ctx,child,value,path,state);if err==nil{matches++;schema.Merge(&combined,evaluated)}else if keyword=="allOf"||!schema.IsValidationError(err){return result,err}};if keyword=="oneOf"&&matches!=1||keyword=="anyOf"&&matches==0{return fail(keyword)};schema.Merge(&result,combined)}
 if child:=node.children["not"];child!=nil{if _,err:=contract.validate(ctx,child,value,path,state);err==nil{return fail("not")}else if !schema.IsValidationError(err){return result,err}}
 if condition:=node.children["if"];condition!=nil{evaluated,err:=contract.validate(ctx,condition,value,path,state);branch:=node.children["else"];if err==nil{schema.Merge(&result,evaluated);branch=node.children["then"]}else if !schema.IsValidationError(err){return result,err};if branch!=nil{if err:=merge(branch);err!=nil{return result,err}}}
 if value.Kind()==types.ValueArray{
  if normalizedFlag(node.raw,"uniqueItems"){unique,err:=schema.UniqueItems(ctx,value);if err!=nil{return result,err};if !unique{return fail("uniqueItems")}}
  matches:=0;for index,item:=range value.Items(){child:=node.children["items"];if index<len(node.lists["prefixItems"]){child=node.lists["prefixItems"][index]};if child!=nil{if _,err:=contract.validate(ctx,child,item,schema.IndexPath(path,index),state);err!=nil{return result,err};result.MarkItem(index)};if contains:=node.children["contains"];contains!=nil{if _,err:=contract.validate(ctx,contains,item,schema.IndexPath(path,index),state);err==nil{matches++;result.MarkItem(index)}else if !schema.IsValidationError(err){return result,err}}}
  if node.children["contains"]!=nil{minimum:=float64(1);if limit,present:=node.raw.Get("minContains");present{minimum,_=limit.Number()};if float64(matches)<minimum{return fail("contains")};if limit,present:=node.raw.Get("maxContains");present{maximum,_:=limit.Number();if float64(matches)>maximum{return fail("maxContains")}}}
 }
 if value.Kind()==types.ValueObject{
  required,_:=node.raw.Get("required");for _,entry:=range required.Items(){name,_:=entry.String();if _,present:=value.Get(name);!present{return result,schema.Failure("required",schema.ChildPath(path,name))}}
  for _,name:=range value.Keys(){if err:=ctx.Err();err!=nil{return result,err};item,_:=value.Get(name);if names:=node.children["propertyNames"];names!=nil{key,_:=types.ValueFrom(name);if _,err:=contract.validate(ctx,names,key,schema.ChildPath(path,name),state);err!=nil{return result,err}};matched:=false;if child:=node.maps["properties"][name];child!=nil{matched=true;if _,err:=contract.validate(ctx,child,item,schema.ChildPath(path,name),state);err!=nil{return result,err};result.MarkKey(name)};for _,pattern:=range normalizedKeys(node.patterns){ok,err:=node.patterns[pattern].Match(ctx,name);if err!=nil{return result,err};if ok{matched=true;if _,err:=contract.validate(ctx,node.maps["patternProperties"][pattern],item,schema.ChildPath(path,name),state);err!=nil{return result,err};result.MarkKey(name)}};if !matched&&node.children["additionalProperties"]!=nil{if _,err:=contract.validate(ctx,node.children["additionalProperties"],item,schema.ChildPath(path,name),state);err!=nil{return result,err};result.MarkKey(name)}}
  dependencies,_:=node.raw.Get("dependentRequired");for _,name:=range dependencies.Keys(){if _,present:=value.Get(name);!present{continue};required,_:=dependencies.Get(name);for _,entry:=range required.Items(){key,_:=entry.String();if _,present:=value.Get(key);!present{return result,schema.Failure("dependentRequired",schema.ChildPath(path,key))}}};for _,name:=range normalizedKeys(node.maps["dependentSchemas"]){if _,present:=value.Get(name);present{if err:=merge(node.maps["dependentSchemas"][name]);err!=nil{return result,err}}}
 }
 if child:=node.children["unevaluatedProperties"];child!=nil&&value.Kind()==types.ValueObject{for _,name:=range value.Keys(){if result.Keys[name]{continue};item,_:=value.Get(name);if _,err:=contract.validate(ctx,child,item,schema.ChildPath(path,name),state);err!=nil{return result,err};result.MarkKey(name)}}
 if child:=node.children["unevaluatedItems"];child!=nil&&value.Kind()==types.ValueArray{for index,item:=range value.Items(){if result.Items[index]{continue};if _,err:=contract.validate(ctx,child,item,schema.IndexPath(path,index),state);err!=nil{return result,err};result.MarkItem(index)}}
 return result,ctx.Err()
}
