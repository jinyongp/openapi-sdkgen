type ClientOptions = types.ClientOptions

type Client struct {
    server types.ServerSelection
    securityProvider types.SecurityProvider
    baseURL *url.URL
    transport types.Transport
    origin string
    defaults types.RequestOptions
    codecs map[string]types.MediaCodec
    streamCodecs map[string]types.StreamCodec
}

func NewClient(options ClientOptions) (*Client, error) {
    var base *url.URL
    if options.BaseURL!=""{var err error;base,err=parseBaseURL(options.BaseURL);if err!=nil{return nil,err}}
    defaults:=requestDefaults(options)
    if err:=validateOptions(defaults);err!=nil{return nil,err}
    if options.HTTPClient!=nil&&options.Transport!=nil{return nil,fmt.Errorf("HTTPClient and Transport cannot both be set")}
    host:=options.Transport
    if host!=nil{
        value:=reflect.ValueOf(host)
        switch value.Kind(){case reflect.Chan,reflect.Func,reflect.Interface,reflect.Map,reflect.Pointer,reflect.Slice:if value.IsNil(){return nil,&types.SDKError{Code:types.RequestOptionsInvalid,Message:"Transport is nil"}}}
    }
    if host==nil{host=transport.NewHTTPClient(options.HTTPClient)}
    codecs:=make(map[string]types.MediaCodec,len(options.Codecs))
    for name,codec:=range options.Codecs{bare,_,_:=strings.Cut(name,";");key:=strings.ToLower(strings.TrimSpace(bare));if key==""{return nil,&types.SDKError{Code:types.RequestOptionsInvalid,Message:"codec media type is empty"}};if _,exists:=codecs[key];exists{return nil,&types.SDKError{Code:types.RequestOptionsInvalid,Message:"codec media types collide after normalization"}};codecs[key]=codec}
    streamCodecs:=make(map[string]types.StreamCodec,len(options.StreamCodecs))
    for name,codec:=range options.StreamCodecs{bare,_,_:=strings.Cut(name,";");key:=strings.ToLower(strings.TrimSpace(bare));if key==""{return nil,&types.SDKError{Code:types.RequestOptionsInvalid,Message:"stream codec media type is empty"}};if _,exists:=streamCodecs[key];exists{return nil,&types.SDKError{Code:types.RequestOptionsInvalid,Message:"stream codec media types collide after normalization"}};streamCodecs[key]=codec}
    if options.Origin!=""{origin,err:=parseBaseURL(options.Origin);if err!=nil{return nil,err};if origin.Path!=""&&origin.Path!="/"{return nil,&types.SDKError{Code:types.RequestOptionsInvalid,Message:"Origin must not contain a path"}};options.Origin=origin.Scheme+"://"+origin.Host}
    return &Client{server:cloneServer(options.Server),securityProvider:options.SecurityProvider,baseURL:base,transport:host,origin:options.Origin,defaults:defaults,codecs:codecs,streamCodecs:streamCodecs},nil
}
