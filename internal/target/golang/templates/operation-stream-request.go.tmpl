    contentType,err:=stream.MultipartContentType(contentType);if err!=nil{return types.Binary{},err};native:=stream.MultipartProtocol{}
    index:=0
    encode:=func(ctx context.Context,value models.{{.ItemModel}})(types.MultipartPart,error){encoded,err:=models.EncodeMedia{{.ItemModel}}(ctx,value);if err!=nil{return types.MultipartPart{},err};part,err:=execution.EncodeMultipartStreamPart(ctx,encoded,index,definitions);index++;return part,err}
    validate:=func(ctx context.Context,value models.{{.ItemModel}})(models.{{.ItemModel}},error){_,err:=models.EncodeMedia{{.ItemModel}}(ctx,value);return value,err}
    {{else}}{{if eq .Framing "line-delimited-json"}}native:=stream.JSONProtocol{}
    {{else if eq .Framing "json-sequence"}}native:=stream.JSONProtocol{Sequence:true}
    {{else if eq .Framing "sse"}}native:=stream.SSEProtocol{}
    {{else}}var native types.StreamProtocol[types.Value]
    {{end}}encode:=models.Encode{{.ItemModel}}
